{
  "name": "rpty-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "rpty 桌面客户端：Electron + xterm.js 6，远端 PTY 的窗口",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron .",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "pnpm run test:profile",
    "test:profile": "tsc src/main/profile.ts --outDir .tmp/profile-test --module es2020 --target es2020 --moduleResolution bundler --skipLibCheck && mv .tmp/profile-test/profile.js .tmp/profile-test/profile.mjs && node test/profile.test.mjs",
    "pack:mac": "electron-vite build && electron-builder --mac dir",
    "pack:linux": "electron-vite build && electron-builder --linux deb"
  },
  "build": {
    "appId": "xin.zhaojian.rpty",
    "productName": "rpty",
    "copyright": "zhaojian",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": "-",
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "maintainer": "zhaojian <zhaojian@users.noreply.github.com>",
      "synopsis": "rpty 远端终端客户端",
      "description": "把远端主机上的 PTY 当成自己的窗口：一对一私密房间、通话密码、多窗口。",
      "icon": "build/icon.png"
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libdrm2",
        "libgbm1",
        "libxcb-dri3-0"
      ]
    }
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.5.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.4.0"
  }
}
